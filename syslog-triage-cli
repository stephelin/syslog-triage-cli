#!/usr/bin/env python3
"""
Syslog Triage CLI
A constant-memory log parsing utility for high-volume production incident triage.
"""

import sys

def triage_log(file_path: str, output_path: str = "incident_report.txt") -> int:
    """
    Streams a log file line-by-line, filters for ERROR and CRITICAL entries,
    and appends structured alerts to an audit log.
    """
    severity_counts = {"ERROR": 0, "CRITICAL": 0}
    total_matches = 0

    try:
        with open(file_path, "r", encoding="utf-8") as infile:
            with open(output_path, "a", encoding="utf-8") as outfile:
                outfile.write(f"\n--- TRIAGE RUN: {file_path} ---\n")
                
                # O(1) space complexity: stream line-by-line to prevent MemoryError
                for line in infile:
                    stripped = line.strip()
                    if not stripped:
                        continue

                    if "ERROR" in stripped or "CRITICAL" in stripped:
                        total_matches += 1
                        if "CRITICAL" in stripped:
                            severity_counts["CRITICAL"] += 1
                        elif "ERROR" in stripped:
                            severity_counts["ERROR"] += 1

                        outfile.write(f"{stripped}\n")

                outfile.write(
                    f"SUMMARY: Total Incidents={total_matches} "
                    f"(CRITICAL: {severity_counts['CRITICAL']}, ERROR: {severity_counts['ERROR']})\n"
                )

        print(f"[SUCCESS] Triage completed. {total_matches} events written to {output_path}")
        return 0

    except FileNotFoundError:
        print(f"[ERROR] Target file not found: {file_path}", file=sys.stderr)
        return 1
    except PermissionError:
        print(f"[ERROR] Permission denied reading: {file_path}", file=sys.stderr)
        return 1
    except Exception as e:
        print(f"[UNEXPECTED ERROR] {e}", file=sys.stderr)
        return 1

if __name__ == "__main__":
    if len(sys.argv) < 2:
        print("Usage: python3 src/triage.py <path_to_logfile>", file=sys.stderr)
        sys.exit(1)

    exit_code = triage_log(sys.argv[1])
    sys.exit(exit_code)
